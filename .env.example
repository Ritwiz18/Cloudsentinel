# CloudSentinel Local Environment Configuration
# Copy this file to .env for local development

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL Database (Local Docker)
POSTGRES_USER=cloudsentinel_user
POSTGRES_PASSWORD=cloudsentinel_dev_password
POSTGRES_DB=cloudsentinel_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudsentinel_user:cloudsentinel_dev_password@127.0.0.1:5432/cloudsentinel_db

# Detection Engine Settings
DETECTION_RULES_ENABLED=true
ALERT_SEVERITY_THRESHOLD=low

# AWS CloudTrail Integration (Phase 5)
AWS_REGION=us-east-1
# SQS Queue URL receiving CloudTrail S3 ObjectCreated notifications
AWS_CLOUDTRAIL_SQS_QUEUE_URL=
# CloudTrail destination S3 bucket
AWS_S3_BUCKET=
# Worker polling settings
AWS_MAX_MESSAGES_PER_POLL=10
AWS_WAIT_TIME_SECONDS=5
AWS_VISIBILITY_TIMEOUT=60
# Optional custom endpoint (e.g. for LocalStack testing: http://localhost:4566)
AWS_ENDPOINT_URL=
